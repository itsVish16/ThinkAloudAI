# ==========================================
# Main Service Environment Variables
# ==========================================

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://thinkaloud:thinkaloud_dev@localhost:5432/main_service

# Redis (Database index 1 for cache, chat buffers, and locks)
REDIS_URL=redis://localhost:6379/1

# RabbitMQ Event Bus
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Shared Authentication
# MUST match Scalable_User_Service JWT_SECRET_KEY
JWT_SECRET_KEY=dev-secret-key-change-me
JWT_ALGORITHM=HS256

# External Services
USER_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://thinkaloudai.tech

# Admin Access Control
ADMIN_EMAILS=admin@yourdomain.com

# LLM Providers (Fireworks AI for System Design & Code Analysis)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/routers/glm-5p2-fast

# E2B Sandbox Code Execution (Required for executing candidate Python/C++ code)
E2B_API_KEY=

# Search & Research Provider (Tavily - optional)
TAVILY_API_KEY=

# Observability (Opik / CometML)
OPIK_API_KEY=
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=ThinkAloud.ai
