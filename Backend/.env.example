# =============================================================================
# ThinkAloudAI Production & Local Deployment Environment Configuration
# =============================================================================
#
# Usage:
# 1. Copy this file to `.env` in the Backend root directory:
#    cp .env.example .env
# 2. Also copy corresponding `.env.example` files into each microservice directory:
#    - Backend/Scalable_User_Service/.env
#    - Backend/main_service/.env
#    - Backend/AI_Interviewer/.env
#    - Frontend/.env
# 3. Fill in your production/local secrets below.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Platform & Gateway Settings
# -----------------------------------------------------------------------------
APP_VERSION=latest
APP_BIND_ADDRESS=127.0.0.1
INFRA_BIND_ADDRESS=127.0.0.1

API_DOMAIN=api.thinkaloudai.tech
ACME_EMAIL=admin@thinkaloudai.tech
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

USER_SERVICE_PORT=8000
MAIN_SERVICE_PORT=8001
AI_INTERVIEWER_API_PORT=8002

POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

FRONTEND_BASE_URL=https://thinkaloudai.tech
CORS_ALLOWED_ORIGINS=https://thinkaloudai.tech,https://www.thinkaloudai.tech,http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# 2. Database (Amazon RDS PostgreSQL or Local Docker Postgres)
# -----------------------------------------------------------------------------
# For Amazon RDS PostgreSQL:
# 1. Create databases in RDS: user_service, main_service, interviewer_service
# 2. Provide the respective async connection strings below:
# Format: postgresql+asyncpg://<RDS_USER>:<RDS_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>
USER_SERVICE_DATABASE_URL=postgresql+asyncpg://thinkaloud_admin:your_rds_password@your-rds-endpoint.c123456789.us-east-1.rds.amazonaws.com:5432/user_service
MAIN_SERVICE_DATABASE_URL=postgresql+asyncpg://thinkaloud_admin:your_rds_password@your-rds-endpoint.c123456789.us-east-1.rds.amazonaws.com:5432/main_service
INTERVIEWER_SERVICE_DATABASE_URL=postgresql+asyncpg://thinkaloud_admin:your_rds_password@your-rds-endpoint.c123456789.us-east-1.rds.amazonaws.com:5432/interviewer_service

# Fallback generic DATABASE_URL (used if service-specific URLs are omitted):
DATABASE_URL=postgresql+asyncpg://thinkaloud:thinkaloud_dev@postgres:5432/user_service

# -----------------------------------------------------------------------------
# 3. Redis In-Memory Cache & Chat Buffers
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# 4. RabbitMQ Message Broker
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=thinkaloud
RABBITMQ_DEFAULT_PASS=thinkaloud_rabbit_secret
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://thinkaloud:thinkaloud_rabbit_secret@rabbitmq:5672/

# -----------------------------------------------------------------------------
# 5. Authentication & Security (CRITICAL: MUST BE IDENTICAL ACROSS ALL SERVICES)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_64_plus_character_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# 4. Admin Access Control (comma-separated list of admin email addresses)
# -----------------------------------------------------------------------------
ADMIN_EMAILS=vishal@example.com,vishal@thinkaloud.ai,vishalsaini160204@gmail.com

# -----------------------------------------------------------------------------
# 5. LiveKit WebRTC Configuration (Real-Time Voice Interview Stream)
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# -----------------------------------------------------------------------------
# 6. Sarvam AI Unified Voice & Dual-LLM Architecture
# -----------------------------------------------------------------------------
SARVAM_API_KEY=sk_empa960w_bfJE5dzfK6wQQYmXC6Thrw2q
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=gemma4

# Sarvam WebSocket Streaming TTS
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws

# Sarvam Streaming STT
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_LANGUAGE=en-IN

# Dual-LLM Voice Pipeline
DUAL_LLM_ENABLED=true
FAST_LLM_API_KEY=sk_empa960w_bfJE5dzfK6wQQYmXC6Thrw2q
FAST_LLM_BASE_URL=https://api.sarvam.ai/v1
FAST_LLM_MODEL=gemma4
FAST_LLM_MAX_TOKENS=35

MAIN_LLM_API_KEY=sk_empa960w_bfJE5dzfK6wQQYmXC6Thrw2q
MAIN_LLM_BASE_URL=https://api.sarvam.ai/v1
MAIN_LLM_MODEL=sarvam-105b

# -----------------------------------------------------------------------------
# 7. Fireworks AI (Used in Main Service for System Design & Code Analysis)
# -----------------------------------------------------------------------------
FIREWORKS_API_KEY=your_fireworks_api_key
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/routers/glm-5p2-fast

# -----------------------------------------------------------------------------
# 8. E2B Sandbox Execution & Search
# -----------------------------------------------------------------------------
E2B_API_KEY=your_e2b_api_key
TAVILY_API_KEY=your_tavily_api_key

# -----------------------------------------------------------------------------
# 9. Observability & Tracing (Opik / CometML & Datadog)
# -----------------------------------------------------------------------------
OPIK_API_KEY=your_opik_api_key
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=ThinkAloud.ai

DD_API_KEY=dummy_or_real_datadog_key
DD_SITE=datadoghq.com
DD_ENV=production
DD_TRACE_ENABLED=false

# -----------------------------------------------------------------------------
# 10. Email Delivery (Optional)
# -----------------------------------------------------------------------------
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM=noreply@thinkaloudai.tech
RESEND_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SQS_EMAIL_QUEUE_URL=
