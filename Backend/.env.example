# =============================================================================
# ThinkAloudAI Production & Local Deployment Environment Configuration
# =============================================================================

APP_VERSION=latest
APP_BIND_ADDRESS=127.0.0.1
INFRA_BIND_ADDRESS=127.0.0.1

API_DOMAIN=api.thinkaloudai.tech
ACME_EMAIL=admin@thinkaloudai.tech
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

USER_SERVICE_PORT=8000
MAIN_SERVICE_PORT=8001
AI_INTERVIEWER_API_PORT=8002

POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

FRONTEND_BASE_URL=https://thinkaloudai.tech
CORS_ALLOWED_ORIGINS=https://thinkaloudai.tech,https://www.thinkaloudai.tech,http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Database (Azure Database for PostgreSQL Flexible Server)
# If username or password contains '@' or special chars, URL-encode them (@ -> %40)
# Format: postgresql+asyncpg://<encoded_user>:<encoded_pass>@<azure_host>:5432/postgres?ssl=require
# -----------------------------------------------------------------------------
POSTGRES_USER=vishalsaini1578504%40gmail.com
POSTGRES_PASSWORD=your_azure_postgres_password
POSTGRES_HOST=thinkaloudai-db.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# Master & microservice database connection strings (all point to database=postgres)
DATABASE_URL=postgresql+asyncpg://vishalsaini1578504%40gmail.com:your_password@thinkaloudai-db.postgres.database.azure.com:5432/postgres?ssl=require
USER_SERVICE_DATABASE_URL=postgresql+asyncpg://vishalsaini1578504%40gmail.com:your_password@thinkaloudai-db.postgres.database.azure.com:5432/postgres?ssl=require
MAIN_SERVICE_DATABASE_URL=postgresql+asyncpg://vishalsaini1578504%40gmail.com:your_password@thinkaloudai-db.postgres.database.azure.com:5432/postgres?ssl=require
INTERVIEWER_SERVICE_DATABASE_URL=postgresql+asyncpg://vishalsaini1578504%40gmail.com:your_password@thinkaloudai-db.postgres.database.azure.com:5432/postgres?ssl=require

# -----------------------------------------------------------------------------
# Redis & RabbitMQ
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

RABBITMQ_DEFAULT_USER=thinkaloud
RABBITMQ_DEFAULT_PASS=thinkaloud_rabbit_secret
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://thinkaloud:thinkaloud_rabbit_secret@rabbitmq:5672/

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_64_plus_character_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

ADMIN_EMAILS=admin@yourdomain.com

# -----------------------------------------------------------------------------
# Email Service (Resend OTP Verification & Password Reset)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ThinkAloudAI <onboarding@resend.dev>
EMAIL_DELIVERY_ENABLED=true

# -----------------------------------------------------------------------------
# LiveKit WebRTC Cloud
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# -----------------------------------------------------------------------------
# Sarvam AI (Voice STT / TTS & Voice Agent LLM)
# -----------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai/v2
SARVAM_MODEL=gemma4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=en-IN

# -----------------------------------------------------------------------------
# Fireworks AI
# -----------------------------------------------------------------------------
FIREWORKS_API_KEY=your_fireworks_api_key
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/routers/glm-5p2-fast

# -----------------------------------------------------------------------------
# E2B Sandbox Execution & Search
# -----------------------------------------------------------------------------
E2B_API_KEY=your_e2b_api_key
TAVILY_API_KEY=your_tavily_api_key

# -----------------------------------------------------------------------------
# Observability (Opik & Datadog)
# -----------------------------------------------------------------------------
OPIK_API_KEY=your_opik_api_key
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=ThinkAloud.ai

DD_API_KEY=dummy_or_real_datadog_key
DD_SITE=datadoghq.com
DD_ENV=production
DD_TRACE_ENABLED=true
