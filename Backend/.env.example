# ThinkAloud.AI Backend - single VM deployment env
#
# Copy this file to `.env` in the Backend directory:
#   cp .env.example .env
#
# Never commit the real `.env`.

# -----------------------------------------------------------------------------
# Runtime / binding
# -----------------------------------------------------------------------------
APP_VERSION=latest
APP_BIND_ADDRESS=127.0.0.1
INFRA_BIND_ADDRESS=127.0.0.1

API_DOMAIN=api.thinkaloudai.tech
ACME_EMAIL=admin@thinkaloudai.tech
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

USER_SERVICE_PORT=8000
MAIN_SERVICE_PORT=8001
AI_INTERVIEWER_API_PORT=8002
POSTGRES_PORT=5432
REDIS_PORT=6379

UVICORN_WORKERS=1

# Comma-separated browser origins allowed to call backend APIs.
# Example production value:
# CORS_ALLOWED_ORIGINS=https://thinkaloudai.tech,https://www.thinkaloudai.tech
CORS_ALLOWED_ORIGINS=https://thinkaloudai.tech,https://www.thinkaloudai.tech
FRONTEND_BASE_URL=https://thinkaloudai.tech

# -----------------------------------------------------------------------------
# Shared Postgres / Redis
# -----------------------------------------------------------------------------
POSTGRES_USER=thinkaloud
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# Redis does not currently use AUTH in this stack. Keep INFRA_BIND_ADDRESS at
# 127.0.0.1 unless you explicitly secure Redis another way.

# -----------------------------------------------------------------------------
# Auth / JWT shared by services
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_64_plus_character_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# User service
# -----------------------------------------------------------------------------
USER_SERVICE_DEBUG=false
USER_SERVICE_WORKERS=2
ENABLE_RATE_LIMITING=true
RATE_LIMIT_TRUST_PROXY_HEADERS=true

EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SQS_EMAIL_QUEUE_URL=

# -----------------------------------------------------------------------------
# Main service AI / coding integrations
# -----------------------------------------------------------------------------
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_API_KEY=replace_me
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3-0324

FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=replace_me
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p2-11b-vision-instruct

AIML_API_KEY=
E2B_API_KEY=
TAVILY_API_KEY=
SPEECHMATICS_API_KEY=

OPIK_API_KEY=
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=ThinkAloud.ai

# -----------------------------------------------------------------------------
# AI interviewer / LiveKit / LLM
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://replace-me.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
CARTESIA_API_KEY=

# OpenAI-compatible LLM endpoint used by AI_Interviewer.
LLM_API_KEY=replace_me
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# -----------------------------------------------------------------------------
# Datadog
# -----------------------------------------------------------------------------
DD_API_KEY=replace_me
DD_SITE=datadoghq.com
DD_ENV=production
DD_TRACE_ENABLED=true
DD_LOGS_INJECTION=true
