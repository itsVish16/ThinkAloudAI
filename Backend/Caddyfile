http://localhost, api.thinkaloudai.tech {
    encode gzip

    # Scalable User Service routes
    handle /api/v1/users* {
        reverse_proxy user-service:8000
    }
    handle /api/v1/admin* {
        reverse_proxy user-service:8000
    }
    handle /health/live {
        reverse_proxy user-service:8000
    }
    handle /health/ready {
        reverse_proxy user-service:8000
    }

    # AI Interviewer routes
    handle /api/token* {
        reverse_proxy ai-interviewer-api:8000
    }
    handle /api/interview-types* {
        reverse_proxy ai-interviewer-api:8000
    }
    handle /api/interview* {
        reverse_proxy ai-interviewer-api:8000
    }
    handle /api/interviews* {
        reverse_proxy ai-interviewer-api:8000
    }
    handle /api/leaderboard* {
        reverse_proxy ai-interviewer-api:8000
    }
    handle /api/admin* {
        reverse_proxy ai-interviewer-api:8000
    }

    # Main Service routes
    handle /chat* {
        reverse_proxy main-service:8001 {
            flush_interval -1
        }
    }
    handle /dsa* {
        reverse_proxy main-service:8001
    }
    handle /roadmaps* {
        reverse_proxy main-service:8001
    }
    handle /system-design* {
        reverse_proxy main-service:8001
    }
    handle /behavioral* {
        reverse_proxy main-service:8001
    }
    handle /pm* {
        reverse_proxy main-service:8001
    }
    handle /aiml* {
        reverse_proxy main-service:8001
    }
    handle /dashboard* {
        reverse_proxy main-service:8001
    }
    handle /admin* {
        reverse_proxy main-service:8001
    }
    handle /sessions* {
        reverse_proxy main-service:8001
    }
    handle /users* {
        reverse_proxy main-service:8001
    }

    # Default fallback to main service
    handle {
        reverse_proxy main-service:8001
    }
}
