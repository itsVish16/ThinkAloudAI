{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	# User service routes.
	reverse_proxy /api/v1/users* user-service:8000
	reverse_proxy /health* user-service:8000

	# AI interviewer API routes. Keep this after /api/v1/users* so auth routes
	# stay on the user service.
	reverse_proxy /api/* ai-interviewer-api:8000

	# Main service routes.
	reverse_proxy /sessions* main-service:8001
	reverse_proxy /chat* main-service:8001
	reverse_proxy /dsa* main-service:8001
	reverse_proxy /roadmaps* main-service:8001
	reverse_proxy /system-design* main-service:8001
	reverse_proxy /users* main-service:8001

	# Default to the main service for root health and future main-service APIs.
	reverse_proxy /* main-service:8001
}
