# LiveKit Credentials
LIVEKIT_URL=wss://<your-livekit-url>
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# Speechmatics Credentials
SPEECHMATICS_API_KEY=<your-speechmatics-api-key>

# Sarvam AI Config
SARVAM_API_KEY=<your-sarvam-api-key>
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# LLM Configuration (OpenAI Compatible)
LLM_API_KEY=${SARVAM_API_KEY}
LLM_MODEL=${SARVAM_LLM_MODEL}
LLM_BASE_URL=https://api.sarvam.ai/v1

# External Scalable User Service JWT Shared Config
USER_SERVICE_JWT_SECRET=<jwt-secret-from-user-service>
USER_SERVICE_JWT_ALGORITHM=HS256

# Database File
DATABASE_PATH=interviewer.db

# PostgreSQL (Docker)
DATABASE_URL=postgresql+asyncpg://thinkaloud:thinkaloud_dev@localhost:5432/interviewer_service

# Redis (Docker)
REDIS_URL=redis://localhost:6379/2
