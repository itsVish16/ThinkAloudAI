# ==========================================
# AI Interviewer Service Environment Variables
# ==========================================

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://thinkaloud:thinkaloud_dev@localhost:5432/interviewer_service

# Redis (Database index 2 for pub/sub & leaderboard)
REDIS_URL=redis://localhost:6379/2

# RabbitMQ Event Bus
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# LiveKit WebRTC Cloud / Self-Hosted Server
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ==========================================
# Sarvam AI Unified Voice & LLM Integration
# ==========================================
SARVAM_API_KEY=sk_empa960w_bfJE5dzfK6wQQYmXC6Thrw2q
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=gemma4

# Sarvam WebSocket Streaming TTS
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws

# Sarvam Streaming STT (Speech-to-Text)
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_LANGUAGE=en-IN

# ==========================================
# Dual-LLM Speculative Voice Architecture
# ==========================================
DUAL_LLM_ENABLED=true

# Fast Responder LLM (Ultra-Low Latency, e.g. Sarvam gemma4 / Fireworks Llama-3.2-3B/8B)
FAST_LLM_API_KEY=sk_empa960w_bfJE5dzfK6wQQYmXC6Thrw2q
FAST_LLM_BASE_URL=https://api.sarvam.ai/v1
FAST_LLM_MODEL=gemma4
FAST_LLM_MAX_TOKENS=35

# Deep Reasoning LLM (Sarvam 105B / Llama-3.3-70B)
MAIN_LLM_API_KEY=sk_empa960w_bfJE5dzfK6wQQYmXC6Thrw2q
MAIN_LLM_BASE_URL=https://api.sarvam.ai/v1
MAIN_LLM_MODEL=sarvam-105b

# Fallback Voice & LLM Keys (Optional)
CARTESIA_API_KEY=
SPEECHMATICS_API_KEY=

# Shared Authentication (MUST match Scalable_User_Service)
JWT_SECRET_KEY=dev-secret-key-change-me
JWT_ALGORITHM=HS256

# Microservice Endpoints
USER_SERVICE_URL=http://localhost:8000
MAIN_SERVICE_URL=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://thinkaloudai.tech

# Admin Access Control & Observability
ADMIN_EMAILS=vishal@example.com,vishal@thinkaloud.ai,vishalsaini160204@gmail.com
OPIK_API_KEY=
OPIK_WORKSPACE=default
