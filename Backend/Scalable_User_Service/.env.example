# ==========================================
# Scalable User Service Environment Variables
# ==========================================

# Server & Debug Mode
DEBUG=false
APP_PORT=8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://thinkaloudai.tech

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://thinkaloud:thinkaloud_dev@localhost:5432/user_service
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10

# Redis (Database index 0)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# Authentication & Security
# IMPORTANT: Generate a strong 256-bit secret key for production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS256
JWT_ISSUER=scalable-user-service
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_TRUST_PROXY_HEADERS=true
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=10/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute
RATE_LIMIT_RESET_PASSWORD=5/minute
RATE_LIMIT_VERIFY_EMAIL=5/minute
RATE_LIMIT_RESEND_VERIFICATION=5/minute

# Cache & Lockout Durations (in seconds)
PROFILE_CACHE_TTL_SECONDS=300
OTP_TTL_SECONDS=900
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Admin Access Control (comma-separated list of admin email addresses)
ADMIN_EMAILS=vishal@example.com,vishal@thinkaloud.ai,vishalsaini160204@gmail.com

# Email Delivery (AWS SQS or Resend - optional in local dev)
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM=noreply@thinkaloudai.tech
RESEND_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SQS_EMAIL_QUEUE_URL=
