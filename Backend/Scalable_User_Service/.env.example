# DATABASE
DATABASE_URL=postgresql+asyncpg://thinkaloud:thinkaloud_dev@localhost:5432/user_service

# REDIS
REDIS_URL=redis://localhost:6379/0
DEBUG=false

# JWT
SECRET_KEY=your_super_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CELERY (Deprecated: Migrated to AWS SQS)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

# EMAIL (Now used by AWS Lambda SQS consumer)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=user_service@thinkaloudai.tech
FRONTEND_BASE_URL=http://localhost:5173

# APP SETTINGS
ENABLE_RATE_LIMITING=true
CORS_ALLOWED_ORIGINS=*

# DATADOG
DD_API_KEY=your_datadog_api_key
DD_SITE=us5.datadoghq.com

# AWS SQS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
SQS_EMAIL_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your_account/your_queue
