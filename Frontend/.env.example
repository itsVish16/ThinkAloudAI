# =============================================================================
# ThinkAloud.AI Frontend Environment Variables (Vercel & Local Development)
# =============================================================================

# For Production Deployment on Vercel:
# Set all service URLs to your EC2 backend domain:
VITE_USER_SERVICE_URL=https://api.thinkaloudai.tech
VITE_MAIN_SERVICE_URL=https://api.thinkaloudai.tech
VITE_AI_SERVICE_URL=https://api.thinkaloudai.tech

# For Local Development (when running backend services locally on ports 8000/8001/8002):
# VITE_USER_SERVICE_URL=http://localhost:8000
# VITE_MAIN_SERVICE_URL=http://localhost:8001
# VITE_AI_SERVICE_URL=http://localhost:8002
